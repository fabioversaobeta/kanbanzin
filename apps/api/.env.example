# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL connection string (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kanbanzin

# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me

# Web app origin(s) allowed by CORS and used in e-mail links (comma separated)
WEB_ORIGIN=http://localhost:5173

# Resend (required in production; in development e-mails are printed to the log)
RESEND_API_KEY=
MAIL_FROM=Kanbanzin <no-reply@kanbanzin.fabiobandacheski.com>
